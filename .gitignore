# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cline agent local skill payloads
.cline/skills/

# Local 3D verification artifacts (scripts/verifyHeroRender.mjs writes to /tmp by default).
# Screenshots are throwaway evidence of one render, not shipped assets.
test-render*.png

# Orphaned avatar scratch: the globe loads /assets/avatars/ (tracked), never /avatars/.
# Kept on disk as source material, deliberately out of history.
public/avatars/
